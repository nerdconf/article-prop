# Required for publishing and reading proposals through Vercel Blob.
# Create a Blob store in Vercel and copy the read/write token here for local dev.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Required for the private publish-bot API and local publish CLI.
PUBLISH_API_TOKEN="replace-with-a-long-random-token"

# Optional for the CLI. Defaults to https://proposal.nerdconf.com when omitted.
PUBLISH_API_BASE_URL="https://proposal.nerdconf.com"
