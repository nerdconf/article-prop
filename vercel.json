{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/og-card.svg",
      "destination": "/og-card.svg"
    },
    {
      "source": "/:slug",
      "destination": "https://yurrulwh11ifng9a.public.blob.vercel-storage.com/proposals/pages/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
